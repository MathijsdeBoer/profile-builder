<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>Profile Builder</name>
  <description>Parametric aluminium T-slot and V-slot extrusion profiles (2020, 2040, 4040, 4080, 4545, ...) on sketch edges, with joints, box frames, panels, brackets, cut lists, stock plans and cost estimates. Largely AI-generated (Claude Opus 5.5); see AI_DISCLOSURE.md.</description>
  <version>0.3.0</version>
  <date>2026-11-11</date>
  <maintainer>Mathijs de Boer</maintainer>
  <license file="COPYING.LESSER">LGPL-3.0-or-later</license>
  <url type="repository" branch="main">https://github.com/MathijsdeBoer/profile-builder</url>
  <url type="bugtracker">https://github.com/MathijsdeBoer/profile-builder/issues</url>
  <url type="readme">https://github.com/MathijsdeBoer/profile-builder/blob/main/README.md</url>
  <icon>freecad/profile_builder/resources/icons/ProfileBuilder.svg</icon>
  <!-- 0.21 lacks the topological naming that keeps profiles on the right edge after sketch edits. -->
  <freecadmin>1.0.0</freecadmin>
  <pythonmin>3.8</pythonmin>
  <!-- Only the Frame stiffness command needs these; FreeCAD's own builds ship both. -->
  <depend type="python" optional="true">numpy</depend>
  <depend type="python" optional="true">scipy</depend>
  <tag>Aluminium profile</tag>
  <tag>T-slot</tag>
  <tag>V-slot</tag>
  <tag>Extrusion</tag>
  <tag>Frame</tag>
  <tag>Cut list</tag>

  <content>
    <workbench>
      <name>Profile Builder</name>
      <classname>ProfileBuilderWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>freecad/profile_builder/resources/icons/ProfileBuilder.svg</icon>
    </workbench>
  </content>
</package>
